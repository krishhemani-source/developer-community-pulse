# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Neon Postgres connection string. Neon console -> your project -> Connect -> copy the "pooled" connection string.
DATABASE_URL=

# Gemini API key. https://aistudio.google.com/apikey -> Create API key.
GEMINI_API_KEY=
# Gemini Flash model id. Latest Flash per https://ai.google.dev/gemini-api/docs/models (Oct 2026).
GEMINI_MODEL=gemini-3.8-flash
# Other Flash models (comma-separated) used automatically when the primary is overloaded (503) or rate-limited (429).
GEMINI_FALLBACK_MODEL=gemini-3.6-flash,gemini-3.5-flash-lite

# Resend API key. https://resend.com/api-keys -> Create API key (Sending access is enough).
RESEND_API_KEY=
# Sender address. Leave empty to use onboarding@resend.dev (can only send to your own Resend account email).
RESEND_FROM=
# Fallback recipient if no recipient is saved on the Settings page.
BRIEF_RECIPIENT_EMAIL=

# Protects /api/cron/weekly. Any long random string, e.g. `openssl rand -hex 32`. Vercel Cron sends it automatically.
CRON_SECRET=
# Optional. If set, editing Settings requires this passcode. Viewing stays public.
ADMIN_PASSCODE=

# Public URL of the deployed app, used for "Open dashboard" links in the email. e.g. https://signalforge.vercel.app
APP_URL=

# Optional. Stack Apps key raises Stack Exchange quota from 300 to 10,000 requests/day. https://stackapps.com/apps/oauth/register
STACKEXCHANGE_KEY=
# Optional. GitHub fine-grained token with no scopes (public read) raises search rate limit. https://github.com/settings/tokens
GITHUB_TOKEN=
